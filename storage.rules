rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAllowedFile() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf|text/.*|application/msword|application/vnd.openxmlformats-officedocument.*');
    }

    match /tohid-dayhami-platform/uploads/{fileName=**} {
      allow read: if true;
      allow write: if isAllowedFile();
    }

    match /tohid-dayhami-platform/images/{fileName=**} {
      allow read: if true;
      allow write: if request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /tohid-dayhami-platform/documents/{fileName=**} {
      allow read: if true;
      allow write: if isAllowedFile();
    }

    match /tohid-dayhami-platform/temp/{fileName=**} {
      allow read: if true;
      allow write: if isAllowedFile();
    }
  }
}
