rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAllowedFile() {
      return request.resource != null
        && request.resource.size < 50 * 1024 * 1024;
    }

    // GLB/GLTF, video, PDF and other large assets in documents/
    function isDocumentFile() {
      return request.resource != null
        && request.resource.size < 100 * 1024 * 1024;
    }

    match /tohid-dayhami-platform/uploads/{allPaths=**} {
      allow read: if true;
      allow write: if isAllowedFile();
    }

    match /tohid-dayhami-platform/images/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource != null
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /tohid-dayhami-platform/documents/{allPaths=**} {
      allow read: if true;
      allow write: if isDocumentFile();
    }

    match /tohid-dayhami-platform/temp/{allPaths=**} {
      allow read: if true;
      allow write: if isAllowedFile();
    }
  }
}
